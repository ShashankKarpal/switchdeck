<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.shashank.switchdeck</string>
  <!-- Do not hand-edit and copy this file. scripts/install.sh renders it
       with your real username, clone path, and interpreter, then boots it.
       This tracked copy is the template: YOU and the paths are
       placeholders, and a plist loaded with them still in place fails to
       spawn.

       Since v1.9.1 the program is the SwitchDeck.app bundle executable, a
       copy of the uv-managed static CPython. macOS only registers
       notification identities for real, LaunchServices-registered app
       bundles, so an unbundled interpreter cannot show banners at all (it
       files notifications into Notification Center silently). The bundle
       holds only the executable, Info.plist, and icon, because codesign
       rejects data files elsewhere; stdlib and site-packages are wired by
       the PYTHONHOME and PYTHONPATH variables below, and switchdeck.py
       scrubs both from every child process so they cannot poison cswap. -->
  <key>ProgramArguments</key>
  <array>
    <string>/Users/YOU/Applications/SwitchDeck.app/Contents/MacOS/SwitchDeck</string>
    <string>/Users/YOU/Projects-with-Claude/switchdeck/switchdeck.py</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/YOU/Projects-with-Claude/switchdeck</string>
  <key>RunAtLoad</key><true/>
  <!-- KeepAlive true so a crash restarts the bar. It does not protect
       against a missing interpreter: launchd gives up on repeated spawn
       failures and reports exit code 78 (EX_CONFIG), which is silent
       because a menu bar app has no window to miss. See the notes in
       docs/STATE.md before changing the venv or the Python behind it. -->
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/Users/YOU/switchdeck.log</string>
  <key>StandardErrorPath</key><string>/Users/YOU/switchdeck.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/Users/YOU/.local/bin</string>
    <key>PYTHONHOME</key>
    <string>/Users/YOU/.local/share/uv/python/cpython-3.14.7-macos-aarch64-none</string>
    <key>PYTHONPATH</key>
    <string>/Users/YOU/.switchdeck-venv/lib/python3.14/site-packages</string>
  </dict>
</dict>
</plist>
